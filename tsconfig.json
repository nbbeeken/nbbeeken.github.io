{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"erasableSyntaxOnly": true,
		"sourceMap": true,
		"types": ["node"],
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"noEmit": false
	},
	"include": ["src"],
	"exclude": ["dist"]
}
